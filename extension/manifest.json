{
  "manifest_version": 3,
  "name": "Quick Calendar",
  "version": "1.0",
  "description": "Add events to Google Calendar from selected text",
  "permissions": [
    "contextMenus",
    "notifications",
    "commands",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5001/*",
    "https://calendar.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["overlay.css"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "open-command-bar": {
      "suggested_key": {
        "default": "Ctrl+G",
        "mac": "Command+G"
      },
      "description": "Open Quick Calendar command bar"
    }
  },
  "icons": {
  }
} 